{
  "name": "hostinger-codex-poc",
  "version": "1.0.0",
  "private": true,
  "description": "Proof of concept: can OpenAI Codex CLI run inside a Hostinger Node.js Web App?",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "inspect": "node scripts/inspect-env.js",
    "probe": "node scripts/probe-child.js",
    "codex:status": "node scripts/codex-check.js",
    "dev": "POC_TOKEN=localtest PORT=3000 node server.js",
    "dev:fresh": "POC_TOKEN=localtest PORT=3000 CODEX_HOME=./.codex-test node server.js",
    "dev:reset": "rm -rf ./.codex-test && echo 'fresh-login state cleared'",
    "diagnose": "node scripts/diagnose-exec.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "optionalDependencies": {
    "@openai/codex": "^0.148.0"
  }
}
