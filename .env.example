# Copy to .env (or set these in the Hostinger hPanel env-var UI).
# NEVER commit real values. NEVER put a real key in this example file.

# Required: shared token that gates every /api/* route.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POC_TOKEN=62EA5BAD4574EBF11DEE132F4B90A428D4FF703E82BBC2EC

# Port. Hostinger injects this automatically - usually leave unset.
# PORT=3000

# --- Codex authentication ---------------------------------------------------
# Option A (API-key auth): set OPENAI_API_KEY here. The app forwards it to the
# Codex child process verbatim and never reads or logs the value.
# OPENAI_API_KEY=
#
# Option B (ChatGPT subscription auth): do NOT set a key. Instead run
# `codex login --device-auth` once over SSH. Credentials land in $CODEX_HOME
# and this app just uses them.

# Where Codex keeps credentials + state. Set this if HOME is unstable under
# the Hostinger process manager (Passenger can hand the app a different HOME).
# CODEX_HOME=/home/YOURUSER/.codex

# --- Tuning -----------------------------------------------------------------
# CODEX_TIMEOUT_MS=120000       # hard wall-clock limit per request
# CODEX_MAX_PROMPT_CHARS=4000   # prompt length cap
# CODEX_MAX_CONCURRENT=2        # simultaneous Codex processes
# CODEX_MAX_QUEUE=8             # queued requests before returning BUSY
# CODEX_MODEL=                  # optional model override
# POC_RATE_LIMIT=20             # requests/min/IP

# DANGEROUS: re-enables Codex's shell/exec tools. Leave unset for the chat POC.
# With this on, Codex CAN read any file your Unix user can read.
# CODEX_ALLOW_SHELL=1
